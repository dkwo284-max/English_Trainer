// Cloudflare Workers 설정 — GitHub main 에 push 하면 자동 배포
//  - 정적 파일(public/*) 호스팅
//  - /api/state : 코드별 학습 이력 (KV: STORE)
//  - /api/ai    : Gemini (비밀 GEMINI_API_KEY)
{
  "name": "english-trainer",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // id 를 비워 두면 wrangler 가 첫 배포 때 KV 를 자동으로 만든다. 자동 생성이 안 되는 환경이면
  // Cloudflare 대시보드 → Storage & Databases → KV 에서 'english-trainer' 를 만들고 그 ID 를 아래에 넣는다.
  "kv_namespaces": [{ "binding": "STORE" }]
}
